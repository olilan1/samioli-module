{
  "name": "samioli-module",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "pack": "node ./build/pack.mjs",
    "test": "vitest run",
    "test:e2e": "npm run test:reset-world && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed:container": "node ./scripts/test-e2e-headed.js",
    "test:reset-world": "node ./scripts/reset-test-world.js",
    "docker:up": "docker compose -f docker-compose.test.yml up -d",
    "docker:down": "docker compose -f docker-compose.test.yml down",
    "report": "playwright show-report",
    "ui:test": "npx playwright test --headed"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.62.0",
    "@types/eslint__js": "^8.42.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jquery": "^3.5.32",
    "@types/node": "^20.14.5",
    "classic-level": "^1.4.1",
    "eslint": "^9.16.0",
    "foundry-pf2e": "github:7H3LaughingMan/foundry-pf2e",
    "fs-extra": "^11.2.0",
    "globals": "^15.9.0",
    "sequencer": "github:fantasycalendar/FoundryVTT-Sequencer",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
