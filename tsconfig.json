{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "types": [
            "vite/client",
            "@7h3laughingman/pf2e-types",
            "@7h3laughingman/foundry-types",
            "sequencer"
        ],
        "baseUrl": ".",
        "paths": {
            "foundry-pf2e": ["node_modules/@7h3laughingman/pf2e-types/src/index.d.ts"],
            "foundry-pf2e/foundry/common/*": ["node_modules/@7h3laughingman/foundry-types/src/common/*"],
            "foundry-pf2e/foundry/client/*": ["node_modules/@7h3laughingman/foundry-types/src/client/*"]
        },
        "resolveJsonModule": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "strict": true,
        "sourceMap": true,
        "skipLibCheck": true,

        // Code checking stuff
        "noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
        "forceConsistentCasingInFileNames": true
    }
}